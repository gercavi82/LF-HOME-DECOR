# ==============================================================================
# L&F HOME DECOR - VARIABLES DE PRODUCCIÓN (cPanel / Application Manager)
# ==============================================================================
# Archivo de ejemplo / plantilla (.env.example)
# En cPanel: Configurar estas variables en "Setup Node.js App" / "Application Manager"

NODE_ENV=production

# Conexión MySQL / MariaDB (creada en cPanel MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_lfhomedecor
DB_USER=cpaneluser_dbuser
DB_PASSWORD=contrasena_segura_mysql

# Parámetros de Sesión y Seguridad
SESSION_COOKIE_NAME=lf_session
SESSION_MAX_AGE=604800
SESSION_SECRET=generar_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
BCRYPT_ROUNDS=12

# URL Pública de la Aplicación
APP_URL=https://mihogaryconfort.com
